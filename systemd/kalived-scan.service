[Unit]
Description=kalived host compromise scan (oneshot)

[Service]
Type=oneshot
# Code is root:root copy — never ExecStart a user-writable git tree.
ExecStart=/usr/local/lib/kalived/scripts/kalived-scan.sh --quiet
Environment=NO_COLOR=1
Environment=KALIVED_DATA=/home/OWNER/kalived
Environment=KALIVED_OWNER=OWNER
SuccessExitStatus=1 2
# 1=WARN 2=ALERT are successful unit runs; notify-send still fires on ALERT.
