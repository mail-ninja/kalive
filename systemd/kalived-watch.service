[Unit]
Description=kalived Hiroshima egress-watch (oneshot)

[Service]
Type=oneshot
ExecStart=/usr/local/lib/kalived/scripts/kalived-watch.sh
Environment=NO_COLOR=1
Environment=HOME=/home/OWNER
Environment=KALIVED_DATA=/home/OWNER/kalived
Environment=KALIVED_OWNER=OWNER
Environment=KALIVED_OWNER_HOME=/home/OWNER
# watch always exits 0/2; 1 unused
SuccessExitStatus=0
