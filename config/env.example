# Copy to ~/.config/kalived/env  (chmod 600). NEVER commit the real file.
# Eller lim inn via cockpit Settings (skriv-bare; GET viser ikke verdien).
# SpaceXAI / xAI — used by the advisor (POST /v1/ai/advise).
# Get a key: https://console.x.ai
#
#   cp config/env.example ~/.config/kalived/env
#   chmod 600 ~/.config/kalived/env
#   # paste the key, no quotes

XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1
# Optional override; config.toml ai_model is the GUI/CLI default.
# XAI_MODEL=grok-4.6

# Inception / Mercury (OpenAI-compatible). https://docs.inceptionlabs.ai
INCEPTION_API_KEY=
INCEPTION_BASE_URL=https://api.inceptionlabs.ai/v1
# INCEPTION_MODEL=mercury-2.5

# GitHub — fine-grained or classic. Scope: repo.
# Ikke git-add denne fila; den skal bare ligge i ~/.config/kalived/env
GITHUB_TOKEN=
# GH_TOKEN=   # valgfri alias (gh CLI)

