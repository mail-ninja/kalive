#!/usr/bin/env bash
# Root-owned dispatcher. ONLY these subcommands. No extra args, no SETENV.
# Installed to /usr/local/sbin/kalived-ctl (root:root 755).
set -euo pipefail
PREFIX=/usr/local/lib/kalived
OWNER="${SUDO_USER:-void}"
HOME_DIR="$(getent passwd "$OWNER" | cut -d: -f6)"
DATA="${HOME_DIR}/kalived"
export KALIVED_ROOT="$PREFIX"
export KALIVED_DATA="$DATA"
export KALIVED_OWNER="$OWNER"
export KALIVED_OWNER_HOME="$HOME_DIR"
export KALIVED_CONFIG="${HOME_DIR}/.config/kalived/config.toml"
export NO_COLOR=1
# Do not pass caller environment into scripts.

if [[ "$(id -u)" -ne 0 ]]; then
  echo "bruk: sudo kalived-ctl {scan|api|defs|token-fix|aide-init|rkhunter-setup|isolate-dst|isolate-undo|kill-pid|watch|uplink-burst|watch-timer-on|watch-timer-off|scan-timer-on|scan-timer-off}" >&2
  echo "daglig: sudo kalived-ctl scan   (exit 0/1/2/3 = CLEAN/WARN/ALERT/ERROR)" >&2
  echo "(Kali sudo PATH mangler /usr/local/sbin — binær ligger i /usr/sbin/kalived-ctl)" >&2
  exit 1
fi

cmd="${1:-}"
if [[ -n "${2:-}" ]]; then
  echo "kalived-ctl: no extra arguments" >&2
  exit 2
fi

case "$cmd" in
  scan)
    exec "$PREFIX/scripts/kalived-scan.sh" --quiet
    ;;
  api)
    exec python3 "$PREFIX/api/server.py"
    ;;
  defs)
    exec "$PREFIX/scripts/update-threat-defs.sh"
    ;;
  token-fix)
    f="${HOME_DIR}/.config/kalived/api.token"
    if [[ -f "$f" ]]; then
      chown "${OWNER}:${OWNER}" "$f"
      chmod 600 "$f"
      echo "token owner → $OWNER ($f)"
    else
      echo "no token yet; start: sudo kalived-ctl api" >&2
      exit 1
    fi
    ;;
  aide-init)
    exec "$PREFIX/playbooks/aide-init.sh" --force
    ;;
  rkhunter-setup)
    exec "$PREFIX/playbooks/rkhunter-setup.sh"
    ;;
  isolate-dst)
    exec "$PREFIX/playbooks/isolate-dst.sh"
    ;;
  isolate-undo)
    exec "$PREFIX/playbooks/isolate-undo.sh"
    ;;
  kill-pid)
    exec "$PREFIX/playbooks/kill-pid.sh"
    ;;
  watch)
    exec "$PREFIX/scripts/kalived-watch.sh"
    ;;
  uplink-burst)
    exec "$PREFIX/scripts/kalived-uplink.sh"
    ;;
  watch-timer-on)
    if [[ ! -f /etc/systemd/system/kalived-watch.timer ]]; then
      echo "Kjør sudo bash playbooks/install-watch-timer.sh først" >&2
      exit 2
    fi
    systemctl enable --now kalived-watch.timer
    python3 "$PREFIX/scripts/lib/kalived_config.py" set watch_timer true
    echo "DONE watch-timer-on"
    ;;
  watch-timer-off)
    systemctl disable --now kalived-watch.timer 2>/dev/null || true
    python3 "$PREFIX/scripts/lib/kalived_config.py" set watch_timer false
    echo "DONE watch-timer-off"
    ;;
  scan-timer-on)
    if [[ ! -f /etc/systemd/system/kalived-scan.timer ]]; then
      echo "Kjør sudo bash playbooks/install-scan-timer.sh først" >&2
      exit 2
    fi
    systemctl enable --now kalived-scan.timer
    python3 "$PREFIX/scripts/lib/kalived_config.py" set timer_enabled true
    echo "DONE scan-timer-on"
    ;;
  scan-timer-off)
    systemctl disable --now kalived-scan.timer 2>/dev/null || true
    python3 "$PREFIX/scripts/lib/kalived_config.py" set timer_enabled false
    echo "DONE scan-timer-off"
    ;;
  *)
    echo "usage: kalived-ctl {scan|api|defs|token-fix|aide-init|rkhunter-setup|isolate-dst|isolate-undo|kill-pid|watch|uplink-burst|watch-timer-on|watch-timer-off|scan-timer-on|scan-timer-off}" >&2
    exit 2
    ;;
esac
